{
  "apiVersion": "hands/v1",
  "kind": "Capability",
  "metadata": {
    "id": "c2b8e4a1-7d3f-4c9a-9e21-5f6a8b0c1d2e",
    "name": "open_auxiliary_share",
    "title": "Open an auxiliary share (product request)",
    "description": "Sign on, open the new-product form, and submit a member identifier. Reaches confirmation on authorized members; permission denial is a business outcome, not a crash. Confirm/Post is irreversible and requires an approved artifact.",
    "version": "1.0.0",
    "createdAt": "2026-08-20T17:00:00.000Z",
    "sourceRunId": "reviewed_open_product",
    "status": "approved",
    "vendorApp": {
      "id": "heritage-core",
      "version": "1.0.0"
    },
    "tenant": {
      "mode": "canonical"
    },
    "surfaceKind": "web",
    "tags": ["heritage-core", "open-product", "canonical", "irreversible"]
  },
  "spec": {
    "entry": {
      "urlTemplate": "http://127.0.0.1:{{port}}/t/{{tenant}}/login",
      "surface": "web"
    },
    "parameters": [
      {
        "name": "tenant",
        "type": "enum",
        "required": true,
        "description": "Institution path prefix for this Heritage Core deployment",
        "pii": "none",
        "enumValues": ["first-federal", "riverside"]
      },
      {
        "name": "memberId",
        "type": "string",
        "required": true,
        "description": "Five-digit member/customer number",
        "pii": "identifier",
        "example": "67890"
      },
      {
        "name": "port",
        "type": "number",
        "required": false,
        "description": "Heritage Core listen port",
        "pii": "none",
        "default": 3401
      }
    ],
    "outputs": [],
    "success": {
      "type": "checkpoint",
      "checkpointId": "on_open_form"
    },
    "steps": [
      {
        "id": "s1",
        "action": "navigate",
        "risk": "safe",
        "valueFrom": {
          "kind": "literal",
          "value": "http://127.0.0.1:{{port}}/t/{{tenant}}/login"
        }
      },
      {
        "id": "s2",
        "action": "fill",
        "risk": "safe",
        "target": {
          "description": "Teller User ID",
          "locators": [
            {
              "strategy": "ax_role_name",
              "role": "textbox",
              "name": "User ID",
              "confidence": 0.95
            }
          ]
        },
        "valueFrom": { "kind": "secret", "ref": "teller_user" }
      },
      {
        "id": "s3",
        "action": "fill",
        "risk": "safe",
        "target": {
          "description": "Teller password",
          "locators": [
            {
              "strategy": "ax_role_name",
              "role": "textbox",
              "name": "Password",
              "confidence": 0.95
            }
          ]
        },
        "valueFrom": { "kind": "secret", "ref": "teller_password" }
      },
      {
        "id": "s4",
        "action": "click",
        "risk": "safe",
        "target": {
          "description": "Sign On",
          "locators": [
            {
              "strategy": "ax_role_name",
              "role": "button",
              "name": "Sign On",
              "confidence": 0.95
            }
          ]
        }
      },
      {
        "id": "s5",
        "action": "click",
        "risk": "safe",
        "target": {
          "description": "Open product menu",
          "locators": [
            {
              "strategy": "ax_role_name",
              "role": "link",
              "name": "Open Auxiliary Share",
              "namePattern": "Open Auxiliary Share|Open Sub-Account",
              "frame": ["header"],
              "confidence": 0.9
            }
          ]
        },
        "checkpoint": {
          "id": "on_open_form",
          "kind": "text_includes",
          "value": "New product request",
          "frame": ["main"]
        }
      },
      {
        "id": "s6",
        "action": "fill",
        "risk": "safe",
        "target": {
          "description": "Member/customer identifier field",
          "locators": [
            {
              "strategy": "ax_role_name",
              "role": "textbox",
              "name": "Member Number",
              "namePattern": "Member Number|Customer No\\.",
              "frame": ["main"],
              "confidence": 0.9
            }
          ]
        },
        "valueFrom": { "kind": "parameter", "name": "memberId" }
      },
      {
        "id": "s7",
        "action": "click",
        "risk": "irreversible",
        "target": {
          "description": "Submit product request",
          "locators": [
            {
              "strategy": "ax_role_name",
              "role": "button",
              "name": "Submit",
              "frame": ["main"],
              "confidence": 0.95
            }
          ]
        }
      }
    ],
    "exceptionHandlers": [
      {
        "id": "h_notice",
        "when": { "match": "unexpected_dialog" },
        "then": {
          "kind": "recover",
          "steps": [
            {
              "id": "r_ok",
              "action": "dismiss_dialog",
              "risk": "safe"
            }
          ]
        }
      },
      {
        "id": "h_not_found",
        "when": { "match": "not_found" },
        "then": {
          "kind": "business_outcome",
          "code": "MEMBER_NOT_FOUND",
          "message": "No CIF record for this identifier"
        }
      },
      {
        "id": "h_validation",
        "when": { "match": "validation_error" },
        "then": {
          "kind": "business_outcome",
          "code": "VALIDATION_ERROR",
          "message": "Identifier failed core validation"
        }
      },
      {
        "id": "h_denied",
        "when": { "match": "permission_denied" },
        "then": {
          "kind": "business_outcome",
          "code": "PERMISSION_DENIED",
          "message": "Teller is not authorized for this product action"
        }
      },
      {
        "id": "h_expired",
        "when": { "match": "session_expired" },
        "then": {
          "kind": "escalate",
          "reason": "Teller session expired; a human must re-authenticate on this live session."
        }
      }
    ]
  }
}
